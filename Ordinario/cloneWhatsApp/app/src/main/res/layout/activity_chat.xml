<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#E5DDD5">

    <!-- Header / Escribiendo... (Fase 8) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#075E54" android:padding="16dp" android:orientation="vertical">
        <TextView android:id="@+id/tvChatNombre" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFF" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvChatEstado" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFF" android:textSize="12sp" android:text="últ. vez hoy / Escribiendo..."/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMensajes" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:padding="8dp"/>

    <!-- Envío de mensajes (Fase 6) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp" android:background="#FFF">
        <EditText android:id="@+id/etChatInput" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="Escribe un mensaje" android:background="@null" android:padding="12dp"/>
        <Button android:id="@+id/btnChatEnviar" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Enviar" android:backgroundTint="#128C7E"/>
    </LinearLayout>
</LinearLayout>