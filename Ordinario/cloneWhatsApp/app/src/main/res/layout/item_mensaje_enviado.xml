<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:padding="4dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="#DCF8C6" android:padding="8dp" android:orientation="vertical" android:layout_marginStart="40dp">
        <TextView android:id="@+id/tvMsgEnviado" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#000" android:textSize="16sp"/>
        <TextView android:id="@+id/tvMsgEstado" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#888" android:textSize="10sp" android:layout_gravity="end"/>
    </LinearLayout>
</LinearLayout>